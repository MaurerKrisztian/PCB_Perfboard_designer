  "pads": [
    {"at": [1, 1], "color": "#38bdf8", "note": "NEW: 60 component variants - 18 above row 29, 13 more in rows 30-56 and 29 more from row 59 down. Enable Labels, then open 3D View. This is a component showcase; the short wires demonstrate routing, not a working circuit."},
    {"at": [4, 1], "color": "#fbbf24", "note": "POWER: 2-pin / 3-pin screw terminals, 7805 and LM317 regulators."},
    {"at": [36, 1], "color": "#60a5fa", "note": "RELAY: G5V-2 DPDT, with coil, common, normally closed and normally open pins."},
    {"at": [3, 7], "color": "#ef4444", "note": "VIN: terminal wiring example."},
    {"at": [5, 7], "color": "#94a3b8", "note": "GND: terminal wiring example."},
    {"at": [10, 7], "color": "#f59e0b", "note": "OUT A: first terminal."},
    {"at": [12, 7], "color": "#38bdf8", "note": "OUT B: second terminal."},
    {"at": [14, 7], "color": "#a78bfa", "note": "OUT C: third terminal."},
    {"at": [3, 9], "color": "#38bdf8", "note": "I/O: resizable female header and a jumper cap with its supporting header pins."},
    {"at": [22, 9], "color": "#fbbf24", "note": "INPUT: 3296W trimmer, KSA tactile push button and SPDT slide switch."},
    {"at": [3, 18], "color": "#ef4444", "note": "OUT 1: female-header routing example."},
    {"at": [4, 17], "color": "#f59e0b"},
    {"at": [5, 16], "color": "#22c55e"},
    {"at": [6, 17], "color": "#38bdf8"},
    {"at": [7, 18], "color": "#a78bfa", "note": "OUT 5: female-header routing example."},
    {"at": [15, 18], "color": "#38bdf8", "note": "18 NEW: thirteen component packages and five named DIP chips, all with 2D and 3D rendering."},
    {"at": [26, 15], "color": "#22c55e", "note": "RGB: four-lead common-cathode and common-anode LEDs. K = cathode, A = anode."},
    {"at": [4, 21], "color": "#a78bfa", "note": "DIP: LM358, LM386, PC817, ULN2803A and 74HC595. All are rotated 90 degrees here."},
    {"at": [1, 30], "color": "#38bdf8", "note": "13 MORE: crystals, resonators, sensors, film capacitors, fuse holders, DIP switches, seven-segment displays, rotary encoders and DC barrel jacks."},
    {"at": [3, 31], "color": "#fbbf24", "note": "TIMING: HC-49/US quartz crystal and 3-pin ceramic resonator (OUT, GND, IN) for microcontroller clocks."},
    {"at": [15, 31], "color": "#22c55e", "note": "SENSORS: photoresistor (LDR) for light and NTC thermistor for temperature, plus a WIMA-style box film capacitor."},
    {"at": [32, 31], "color": "#ef4444", "note": "PROTECTION: 5x20 mm fuse holder, pins nine holes apart."},
    {"at": [3, 38], "color": "#a78bfa", "note": "DIP SWITCHES: 2-, 4- and 8-position. Switch k joins pin k (bottom row) to the pin straight above it."},
    {"at": [26, 38], "color": "#f59e0b", "note": "DISPLAYS: 0.56 inch seven-segment, common cathode (CC) and common anode (CA). Pins 3 and 8 are the common."},
    {"at": [10, 48], "color": "#38bdf8", "note": "CONTROLS: rotary encoder with push switch (A, C, B / S1, S2) and a 5.5 x 2.1 mm DC barrel jack (CTR, SLV, SW)."},
    {"at": [12, 56], "color": "#ef4444", "note": "VIN: barrel jack center pin wiring example."},
    {"at": [14, 56], "color": "#94a3b8", "note": "GND: barrel jack sleeve wiring example."},
    {"at": [1, 59], "color": "#38bdf8", "note": "29 MORE: DIP chips, switches, 3 mm LEDs, bar graph and 4-digit displays, sensors, audio, JST XH connectors and battery holders."},
    {"at": [3, 60], "color": "#a78bfa", "note": "DIP: ATtiny85, LM393, TL072, 4N35, 6N137, NE556, L293D, CD4017 and 74HC14, rotated 90 degrees like the chips above."},
    {"at": [3, 75], "color": "#fbbf24", "note": "SWITCHES: 6x6 mm tactile, 8x8 mm latching DPDT, MTS-102 SPDT and MTS-202 DPDT toggles. Plus red and green 3 mm LEDs (right-click an LED to change its color)."},
    {"at": [3, 83], "color": "#f59e0b", "note": "DISPLAYS: 10-segment bar graph (A1-A10 anodes, K1-K10 cathodes) and 4-digit seven-segment displays. DG1-DG4 are the digit commons."},
    {"at": [1, 94], "color": "#22c55e", "note": "SENSORS: DS18B20 temperature, TSOP38238 IR receiver, electret microphone, DHT22 and DHT11 humidity sensors."},
    {"at": [1, 104], "color": "#38bdf8", "note": "CONNECTORS: 3.5 mm stereo audio jack (SLV, TIP, RNG) and 2-, 3- and 4-pin JST XH."},
    {"at": [32, 103], "color": "#ef4444", "note": "BATTERIES: CR2032 coin cell, 2 x AA and 18650 holders. Pin labels mark + and -."}
  ],
